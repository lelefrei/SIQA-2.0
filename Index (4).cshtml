@model IEnumerable<SIQA.Models.Leitura>

@{
    ViewData["Title"] = "Leituras";
}

<div class="container mt-4">
    <h1>Histórico de leituras</h1>

    <p class="text-muted">
        Últimas 100 leituras registradas no SIQA.
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Data e hora</th>
                    <th>Temperatura</th>
                    <th>Umidade</th>
                    <th>Origem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var leitura in Model)
                    {
                        <tr>
                            <td>
                                @leitura.DataHora.ToString("dd/MM/yyyy HH:mm:ss")
                            </td>
                            <td>@leitura.Temperatura.ToString("F1") °C</td>
                            <td>@leitura.Umidade.ToString("F1")%</td>
                            <td>@leitura.Origem</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">
                            Nenhuma leitura encontrada.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-primary">
        Voltar ao Dashboard
    </a>
</div>
