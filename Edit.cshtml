@model SIQA.Models.Ambiente

@{
    ViewData["Title"] = "Editar ambiente";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Editar ambiente</h2>
        <p class="text-muted">
            Atualize as informações do ambiente selecionado.
        </p>
    </div>

    <div class="card border-0 shadow-sm" style="max-width: 650px;">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">
                        Nome do ambiente
                    </label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Localizacao" class="form-label">
                        Localização
                    </label>
                    <input asp-for="Localizacao" class="form-control" />
                    <span asp-validation-for="Localizacao"
                          class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-4">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label asp-for="Ativo" class="form-check-label">
                        Ambiente ativo
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
